    {
      "name": "GET /v1/forecast - Thời tiết hiện tại tại TP. Hồ Chí Minh",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{weatherUrl}}/v1/forecast?latitude={{latitude}}&longitude={{longitude}}&current=temperature_2m,wind_speed_10m",
          "host": [
            "{{weatherUrl}}"
          ],
          "path": [
            "v1",
            "forecast"
          ],
          "query": [
            {
              "key": "latitude",
              "value": "{{latitude}}"
            },
            {
              "key": "longitude",
              "value": "{{longitude}}"
            },
            {
              "key": "current",
              "value": "temperature_2m,wind_speed_10m"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Weather response contains current temperature and wind speed', function () {",
              "    const weather = pm.response.json();",
              "    pm.expect(weather.current).to.be.an('object');",
              "    pm.expect(weather.current.temperature_2m).to.be.a('number');",
              "    pm.expect(weather.current.wind_speed_10m).to.be.a('number');",
              "    pm.expect(weather.current_units.temperature_2m).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
